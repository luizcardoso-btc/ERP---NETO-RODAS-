{
  "name": "netorodas/erp-pneus",
  "description": "ERP Pneus - Neto Rodas",
  "type": "project",
  "require": { "php": ">=8.1", "ext-pdo": "*", "ext-pdo_mysql": "*", "ext-mbstring": "*" },
  "require-dev": { "phpunit/phpunit": "^10.5" },
